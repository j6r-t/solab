// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id           String         @id @default(cuid())
  name         String
  familyName   String
  phone        String         @unique
  address      String?
  gender       Gender?
  prescription Prescription[]
  orders       Order[]
  smsLogs      SmsLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum Gender {
  female
  male
}

model Prescription {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  //right eye prescription 
  sphRight  Decimal
  cylRight  Decimal
  axisRight Int
  addRight  Decimal
  pdRight   Int

  //left eye prescription 
  sphLeft  Decimal
  cylLeft  Decimal
  axisLeft Int
  addLeft  Decimal
  pdLeft   Int

  doctorName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  name             String
  brand            String
  model            String
  category         ProductCategory?
  price            Decimal
  quantity         Int               @default(0)
  qrcode           QRCode?
  orderItems       OrderItem[]
  StockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductCategory {
  eyewear
  lens
  accessory
}

model QRCode {
  id        String   @id @default(cuid())
  productId String   @unique
  code      String   @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  totalAmount Decimal
  orderType   OrderType   @default(standard)
  status      OrderStatus @default(pending)
  items       OrderItem[]
  payments    Payment[]
  repairs     Repair[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderType {
  standard //Standard purchase (eyewear + lenses)
  remounting //Remounting(client's own frame + new lenses)
  direct_sale //Direct sale (accessories,lens only or glasses only)
}

enum OrderStatus {
  pending
  completed
  cancelled
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal
}

model Payment {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal
  type      PaymentType
  createdAt DateTime    @default(now())
}

enum PaymentType {
  deposit
  balance
  full
}

model Repair {
  id                     String         @id @default(cuid())
  orderId                String
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                   String
  status                 RepairStatus   @default(pending)
  expectedCompletionDate DateTime
  repairServiceId        String?
  repairService          RepairService? @relation(fields: [repairServiceId], references: [id])
  price                  Decimal
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model RepairService {
  id           String   @id @default(cuid())
  name         String
  defaultPrice Decimal
  repairs      Repair[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum RepairStatus {
  pending
  completed
  cancelled
}

model StockAdjustment {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  reason    StockAdjustmentReason
  createdAt DateTime              @default(now())
}

enum StockAdjustmentReason {
  restock
  damage
  adjustment
  sale
}

model SmsLog {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phone     String
  message   String
  status    SmsStatus
  createdAt DateTime  @default(now())
}

enum SmsStatus {
  sent
  failed
}
