generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────
// Enums
// ───────────────────────────────

enum Gender {
  female
  male
}

enum UserRole {
  admin
  shop
  atelier
}

enum OrderType {
  standard
  remounting
  direct_sale
}

enum OrderStatus {
  pending
  ready
  completed
  cancelled
}

enum PaymentType {
  deposit
  balance
  full
}

enum PaymentMethod {
  cash
  cheque
  card
}

enum ChequeStatus {
  pending
  deposited
  cashed
  bounced
  paid
  overdue
  cancelled
}

enum ChequeType {
  standard
  traite
}

enum ChequeEntityType {
  client_payment
  supplier_payment
}

enum ProductCategory {
  lunette
  lentille
  verre
  accessory
  nettoyant_lentilles
  nettoyant_monture
}

enum LensType {
  singleVision
  progressive
  bifocal
  office
  photochromic
}

enum LensMaterial {
  cr39
  polycarbonate
  highIndex
  trivex
}

enum LensCoating {
  none
  ar
  scratchResistant
  blueBlock
  arScratch
  arBlueBlock
}

enum AtelierWorkOrderStatus {
  pending
  in_progress
  completed
  delivered
  cancelled
}

enum WorkOrderSource {
  internal
  optician
}

enum PaymentStatus {
  pending
  partial
  paid
}

enum BrokenLensBlank {
  none
  left
  right
  both
}

enum InvoiceEntity {
  shop
  atelier
}

enum BillStatus {
  unpaid
  partiallyPaid
  paid
}

enum BillItemType {
  service
  lens_blank
}

enum StockAdjustmentReason {
  restock
  damage
  adjustment
  sale
}

enum LensBlankAdjustmentReason {
  purchased
  used_in_mounting
  used_in_repair
  broken_during_mounting
}

// ───────────────────────────────
// Models
// ───────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(admin)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id           String         @id @default(uuid())
  name         String
  familyName   String
  phone        String         @unique
  address      String?
  gender       Gender?
  birthDate    String?
  notes        String?
  organization String?
  prescription Prescription[]
  orders       Order[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
}

model Doctor {
  id             String         @id @default(uuid())
  name           String
  phone          String
  address        String?
  specialization String?
  prescriptions  Prescription[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
}

model Fournisseur {
  id              String             @id @default(uuid())
  name            String
  phone           String
  address         String?
  email           String?
  taxId           String?
  entity          String             @default("shop")
  products        Product[]
  purchaseInvoices PurchaseInvoice[]
  lensBlanks      LensBlank[]
  supplierConsolidatedInvoices SupplierConsolidatedInvoice[] @relation("FournisseurConsolidatedInvoices")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
}

model OpticianShop {
  id            String                    @id @default(uuid())
  name          String
  phone         String
  address       String?
  notes         String?
  workOrders    AtelierWorkOrder[]        @relation("OpticianShopWorkOrders")
  prescriptions OpticianShopPrescription[] @relation("OpticianShopPrescriptions")
  bills         OpticianShopBill[]        @relation("OpticianShopBills")
  consolidatedInvoices ConsolidatedInvoice[] @relation("ConsolidatedInvoices")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  deletedAt     DateTime?
}

model Prescription {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  sphRight  Decimal
  cylRight  Decimal
  axisRight Int
  addRight  Decimal
  pdRight   Int

  sphLeft  Decimal
  cylLeft  Decimal
  axisLeft Int
  addLeft  Decimal
  pdLeft   Int

  doctorId   String?
  doctor     Doctor?  @relation(fields: [doctorId], references: [id])
  dateWritten DateTime?
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String            @id @default(uuid())
  name             String
  brand            String
  model            String
  category         ProductCategory?
  price            Decimal
  priceAfterTax    Decimal?
  costPrice        Decimal?
  quantity         Int               @default(0)
  thickness        String?
  lensType         LensType?
  material         LensMaterial?
  coating          LensCoating?
  sph              Decimal?
  cyl              Decimal?
  add              Decimal?
  fournisseurId    String?
  fournisseur      Fournisseur?      @relation(fields: [fournisseurId], references: [id])
  qrcode           QRCode?
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QRCode {
  id        String   @id @default(uuid())
  productId String   @unique
  code      String   @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  totalAmount Decimal
  orderType   OrderType   @default(standard)
  status      OrderStatus @default(pending)
  items       OrderItem[]
  payments    Payment[]
  workOrders  AtelierWorkOrder[]
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  prescriptionId String?
  turnaroundDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lensBlankId  String?
  lensBlank    LensBlank? @relation(fields: [lensBlankId], references: [id], onDelete: Restrict)
  name         String?
  quantity     Int
  unitPrice    Decimal
  sellingPrice Decimal?

  @@index([orderId])
}

model Payment {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal
  type      PaymentType
  method    PaymentMethod? @default(cash)
  chequeId  String?
  cheque    Cheque?        @relation(fields: [chequeId], references: [id])
  dueDate   DateTime?
  createdAt DateTime       @default(now())

  @@index([orderId])
}

model Cheque {
  id                 String                @id @default(uuid())
  number             String
  type               ChequeType            @default(standard)
  bankName           String?
  amount             Decimal
  issueDate          DateTime              @default(now())
  dueDate            DateTime
  status             ChequeStatus          @default(pending)
  entityType         ChequeEntityType
  payments           Payment[]
  supplierPayments   SupplierPayment[]
  opticianShopPayments OpticianShopPayment[]
  consolidatedPayments ConsolidatedPayment[]
  supplierConsolidatedPayments SupplierConsolidatedPayment[]
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model PurchaseInvoice {
  id              String                 @id @default(uuid())
  invoiceNumber   String
  fournisseurId   String
  fournisseur     Fournisseur            @relation(fields: [fournisseurId], references: [id])
  entity          InvoiceEntity
  date            DateTime               @default(now())
  totalAmount     Decimal
  paidAmount      Decimal                @default(0)
  notes           String?
  items           PurchaseInvoiceItem[]
  payments        SupplierPayment[]
  lensBlankAdjustments LensBlankAdjustment[]
  groupedIntoId   String?
  groupedInto     SupplierConsolidatedInvoice?  @relation("PurchaseInvoiceGroupedInto", fields: [groupedIntoId], references: [id], onDelete: SetNull)
  groupedItem     SupplierConsolidatedInvoiceItem? @relation("SupplierConsolidatedSource")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model PurchaseInvoiceItem {
  id          String           @id @default(uuid())
  invoiceId   String
  invoice     PurchaseInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  lensBlankId String?
  lensBlank   LensBlank?       @relation(fields: [lensBlankId], references: [id])
  description String?
  category    String?
  quantity    Int
  unitPrice   Decimal
}

model SupplierPayment {
  id                String           @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  amount            Decimal
  method            PaymentMethod
  chequeId          String?
  cheque            Cheque?          @relation(fields: [chequeId], references: [id])
  paidAt            DateTime         @default(now())
}

model LensBlank {
  id            String    @id @default(uuid())
  brand         String
  lensType      LensType
  material      LensMaterial
  coating       LensCoating
  thickness     String
  sph           Decimal
  cyl           Decimal
  costPrice     Decimal
  sellingPrice  Decimal
  priceAfterTax Decimal?
  quantity      Int       @default(0)
  fournisseurId String?
  fournisseur   Fournisseur?           @relation(fields: [fournisseurId], references: [id])
  adjustments   LensBlankAdjustment[]
  invoiceItems  PurchaseInvoiceItem[]
  orderItems    OrderItem[]
  workOrdersLeft      AtelierWorkOrder[]  @relation("lensBlankLeft")
  workOrdersRight     AtelierWorkOrder[]  @relation("lensBlankRight")
  replacementLeftFor  AtelierWorkOrder[]  @relation("replacementLeft")
  replacementRightFor AtelierWorkOrder[]  @relation("replacementRight")
  opticianBillItems   OpticianShopBillItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LensBlankAdjustment {
  id          String                    @id @default(uuid())
  lensBlankId String
  lensBlank   LensBlank                 @relation(fields: [lensBlankId], references: [id], onDelete: Cascade)
  quantity    Int
  reason      LensBlankAdjustmentReason
  workOrderId String?
  workOrder   AtelierWorkOrder?         @relation(fields: [workOrderId], references: [id])
  invoiceId   String?
  invoice     PurchaseInvoice?          @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime                  @default(now())
}

model AtelierWorkOrder {
  id              String                 @id @default(uuid())
  orderId         String?
  order           Order?                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  opticianShopId  String?
  opticianShop    OpticianShop?          @relation("OpticianShopWorkOrders", fields: [opticianShopId], references: [id], onDelete: SetNull)
  source          WorkOrderSource

  status          AtelierWorkOrderStatus @default(pending)

  // Lens details
  lensBlankLeftId  String?
  lensBlankLeft    LensBlank?            @relation("lensBlankLeft", fields: [lensBlankLeftId], references: [id])
  lensBlankRightId String?
  lensBlankRight   LensBlank?            @relation("lensBlankRight", fields: [lensBlankRightId], references: [id])

  // Pricing
  lensBlankPrice   Decimal?
  servicePrice     Decimal               @default(0)

  // Payment
  paymentStatus    PaymentStatus         @default(pending)
  amountPaid       Decimal               @default(0)

  // Timing
  startedAt        DateTime?
  completedAt      DateTime?
  dueDate          DateTime
  expectedCompletionDate DateTime?

  // Services (multi-select)
  workOrderServices WorkOrderService[]

  // Optician shop prescription (separate from client prescriptions)
  prescription   OpticianShopPrescription?

  // Bill (created when lenses from our stock)
  bill           OpticianShopBill?

  // Breakage
  brokenLensBlank  BrokenLensBlank?      @default(none)
  replacementLeftId  String?
  replacementLeft    LensBlank?          @relation("replacementLeft", fields: [replacementLeftId], references: [id])
  replacementRightId String?
  replacementRight   LensBlank?          @relation("replacementRight", fields: [replacementRightId], references: [id])

  // Adjustments linked to this work order
  adjustments      LensBlankAdjustment[]

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([opticianShopId])
}

model RepairService {
  id               String              @id @default(uuid())
  name             String
  defaultPrice     Decimal
  workOrderServices WorkOrderService[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model LensBrand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model StockAdjustment {
  id        String                @id @default(uuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  reason    StockAdjustmentReason
  createdAt DateTime              @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
}

// ───────────────────────────────
// Optician Shop Work Order Models
// ───────────────────────────────

model OpticianShopPrescription {
  id              String              @id @default(uuid())
  opticianShopId  String
  opticianShop    OpticianShop        @relation("OpticianShopPrescriptions", fields: [opticianShopId], references: [id], onDelete: Restrict)
  workOrderId     String?             @unique
  workOrder       AtelierWorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  // Optical prescription (per eye)
  sphRight  Decimal
  cylRight  Decimal
  axisRight Int
  addRight  Decimal
  pdRight   Int
  sphLeft   Decimal
  cylLeft   Decimal
  axisLeft  Int
  addLeft   Decimal
  pdLeft    Int

  // Lens preferences
  thickness String?
  lensType  LensType?
  material  LensMaterial?
  coating   LensCoating?

  notes     String?
  createdAt DateTime  @default(now())
}

model WorkOrderService {
  id              String           @id @default(uuid())
  workOrderId     String
  workOrder       AtelierWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  repairServiceId String
  repairService   RepairService    @relation(fields: [repairServiceId], references: [id], onDelete: Restrict)
  price           Decimal

  @@unique([workOrderId, repairServiceId])
}

model OpticianShopBill {
  id              String                 @id @default(uuid())
  billNumber      String                 @unique
  opticianShopId  String
  opticianShop    OpticianShop           @relation("OpticianShopBills", fields: [opticianShopId], references: [id], onDelete: Restrict)
  workOrderId     String?                @unique
  workOrder       AtelierWorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  totalAmount     Decimal
  paidAmount      Decimal                @default(0)
  status          BillStatus             @default(unpaid)
  notes           String?
  items           OpticianShopBillItem[]
  payments        OpticianShopPayment[]
  groupedIntoId   String?
  groupedInto     ConsolidatedInvoice?   @relation("BillGroupedInto", fields: [groupedIntoId], references: [id], onDelete: SetNull)
  groupedItem     ConsolidatedInvoiceItem? @relation("ConsolidatedSourceBill")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model OpticianShopBillItem {
  id              String           @id @default(uuid())
  billId          String
  bill            OpticianShopBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int              @default(1)
  unitPrice       Decimal
  itemType        BillItemType
  lensBlankId     String?
  lensBlank       LensBlank?       @relation(fields: [lensBlankId], references: [id])
  createdAt       DateTime         @default(now())
}

model OpticianShopPayment {
  id        String           @id @default(uuid())
  billId    String
  bill      OpticianShopBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Decimal
  method    PaymentMethod
  chequeId  String?
  cheque    Cheque?          @relation(fields: [chequeId], references: [id])
  notes     String?
  paidAt    DateTime         @default(now())
}

model ConsolidatedInvoice {
  id             String                    @id @default(uuid())
  invoiceNumber  String                    @unique
  opticianShopId String
  opticianShop   OpticianShop              @relation("ConsolidatedInvoices", fields: [opticianShopId], references: [id], onDelete: Cascade)
  totalAmount    Decimal
  paidAmount     Decimal                   @default(0)
  status         BillStatus                @default(unpaid)
  notes          String?
  items          ConsolidatedInvoiceItem[]
  payments       ConsolidatedPayment[]
  groupedBills   OpticianShopBill[]        @relation("BillGroupedInto")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model ConsolidatedInvoiceItem {
  id                    String              @id @default(uuid())
  consolidatedInvoiceId String
  consolidatedInvoice   ConsolidatedInvoice @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: Cascade)
  sourceBillId          String              @unique
  sourceBill            OpticianShopBill    @relation("ConsolidatedSourceBill", fields: [sourceBillId], references: [id], onDelete: Restrict)
  sourceBillNumber      String
  amount                Decimal
  createdAt             DateTime            @default(now())
}

model ConsolidatedPayment {
  id                    String              @id @default(uuid())
  consolidatedInvoiceId String
  consolidatedInvoice   ConsolidatedInvoice @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: Cascade)
  amount                Decimal
  method                PaymentMethod
  chequeId              String?
  cheque                Cheque?             @relation(fields: [chequeId], references: [id])
  notes                 String?
  paidAt                DateTime            @default(now())
}

model SupplierConsolidatedInvoice {
  id             String                           @id @default(uuid())
  invoiceNumber  String                           @unique
  fournisseurId  String
  fournisseur    Fournisseur                      @relation("FournisseurConsolidatedInvoices", fields: [fournisseurId], references: [id], onDelete: Cascade)
  entity         InvoiceEntity
  totalAmount    Decimal
  paidAmount     Decimal                          @default(0)
  status         BillStatus                       @default(unpaid)
  notes          String?
  items          SupplierConsolidatedInvoiceItem[]
  payments       SupplierConsolidatedPayment[]
  groupedInvoices PurchaseInvoice[]                @relation("PurchaseInvoiceGroupedInto")
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
}

model SupplierConsolidatedInvoiceItem {
  id                      String                      @id @default(uuid())
  consolidatedInvoiceId   String
  consolidatedInvoice     SupplierConsolidatedInvoice @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: Cascade)
  sourcePurchaseInvoiceId String                      @unique
  sourcePurchaseInvoice   PurchaseInvoice             @relation("SupplierConsolidatedSource", fields: [sourcePurchaseInvoiceId], references: [id], onDelete: Restrict)
  sourceInvoiceNumber     String
  amount                  Decimal
  createdAt               DateTime                    @default(now())
}

model SupplierConsolidatedPayment {
  id                    String                      @id @default(uuid())
  consolidatedInvoiceId String
  consolidatedInvoice   SupplierConsolidatedInvoice @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: Cascade)
  amount                Decimal
  method                PaymentMethod
  chequeId              String?
  cheque                Cheque?                     @relation(fields: [chequeId], references: [id])
  notes                 String?
  paidAt                DateTime                    @default(now())
}
