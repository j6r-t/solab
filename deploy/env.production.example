# =============================================================
# Solab — production environment template
# Copy to the project root as `.env` and fill in real values:
#   cp deploy/env.production.example .env
# Variable names below are the exact ones the code reads (verified).
# NEVER commit the filled-in .env, and never copy your dev secrets here.
# =============================================================

# --- REQUIRED: SQLite database -------------------------------
# `file:` paths are resolved relative to the prisma/ folder (where
# schema.prisma lives) → this creates/uses  prisma/db/production.db
# (same convention as the dev database prisma/db/dev.db).
# Absolute form (recommended on the VPS, path-independent):
#   DATABASE_URL=file:/opt/solab/prisma/db/production.db
DATABASE_URL=file:./db/production.db

# --- REQUIRED: auth token signing secret ---------------------
# (this codebase uses JWT_SECRET — there is no AUTH_SECRET variable)
# Generate (Node is installed):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be a NEW value — the development secret is considered exposed.
JWT_SECRET=CHANGE_ME_generate_a_new_random_48_byte_base64_value

# --- OPTIONAL: OCR prescription extraction (Groq) ------------
# Leave GROQ_API_KEY blank and the app works fine; only the OCR
# endpoint refuses to run. Rotate the old dev key before go-live!
# Free keys: https://console.groq.com/keys
GROQ_API_KEY=
# Model override; repo default: groq/compound
GROQ_MODEL=groq/compound

# --- Application ---------------------------------------------
NODE_ENV=production
# Port for `next start`; defaults to 3000 if unset.
PORT=3000
